---
permalink: false
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ category }} - Peak Interval Blog</title>

    <!-- SEO Meta Tags -->
    <meta name="description" content="Read the latest {{ category }} articles on the Peak Interval Blog.">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://www.peakintervalapp.com/blog/{{ category | slugify }}">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="{{ category }} - Peak Interval Blog">
    <meta property="og:description" content="Read the latest {{ category }} articles on the Peak Interval Blog.">
    <meta property="og:image" content="https://www.peakintervalapp.com/assets/app_icon.png">
    <meta property="og:url" content="https://www.peakintervalapp.com/blog/{{ category | slugify }}">
    <meta property="og:type" content="website">

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ category }} - Peak Interval Blog">
    <meta name="twitter:description" content="Read the latest {{ category }} articles on the Peak Interval Blog.">
    <meta name="twitter:image" content="https://www.peakintervalapp.com/assets/app_icon.png">
    {% include "site-head.liquid" %}
</head>
<body>
{% include "site-header.liquid", active: "blog" %}
    
    <div class="page-head">
        <a class="kicker" href="/blog">Training guides</a>
        <h1 class="category-title">{{ category }}</h1>
        <p class="category-description">
            {% if category == "HIIT Fundamentals" %}
                Learn the basics and core principles of High-Intensity Interval Training.
            {% elsif category == "Workout Guides" %}
                Explore effective HIIT workout routines designed for different fitness levels and goals.
            {% elsif category == "App Features" %}
                Discover how to get the most out of the Peak Interval app with these feature guides.
            {% elsif category == "Specialized HIIT Training" %}
                HIIT workouts tailored for specific activities, sports, and special populations.
            {% elsif category == "Fitness + Nutrition" %}
                Nutrition strategies and fitness tips to maximize your HIIT training results.
            {% elsif category == "HIIT Success Stories" %}
                Real-life transformations and success stories from HIIT enthusiasts.
            {% elsif category == "Advanced HIIT Concepts" %}
                Advanced training methodologies and scientific concepts behind HIIT.
            {% else %}
                Browse our collection of articles about {{ category }}.
            {% endif %}
        </p>
    </div>
    
    <div class="blog-content category-page">
        <a href="/blog" class="back-link">← Back to Categories</a>
        
        <div class="blog-posts">
            {%- assign posts = collections.posts | reverse -%}
            {%- for post in posts -%}
                {% if post.data.category == category %}
                <div class="blog-post-card">
                    <a href="{{ post.url | url }}" class="post-link">
                        {% if post.data.featured_image %}
                        <img src="{{ post.data.featured_image | url }}" alt="{{ post.data.image_alt | default: post.data.title }}" class="post-thumbnail">
                        {% else %}
                        <div class="post-thumbnail-placeholder"></div>
                        {% endif %}
                        <div class="post-details">
                            <h2 class="post-title">{{ post.data.title }}</h2>
                            {% if post.date %}
                            <div class="post-meta">Published on {{ post.date | date: "%B %d, %Y" }}</div>
                            {% endif %}
                            <p class="post-excerpt">
                                {{ post.data.description }}
                            </p>
                            <span class="read-more">Read More →</span>
                        </div>
                    </a>
                </div>
                {% endif %}
            {%- endfor -%}
        </div>
    </div>
    
{% include "site-footer.liquid" %}


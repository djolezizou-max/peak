                </a>
            </div>
            
            <!-- Workout Guides -->
            <div class="category-card">
                <a href="/blog/app-workout-guides" class="category-link">
                    <img src="/assets/blog/workouts-programs-category.jpg" alt="Workouts & Programs" class="category-image">
                </a>
            </div>
            
            <!-- App Features -->
            <!-- <div class="category-card">
                <a href="/blog/app-features" class="category-link">
                    <img src="/assets/blog/app-features-category.jpg" alt="App Features" class="category-image">
                </a>
            </div> -->
            
            <!-- Specialized HIIT Training -->
            <div class="category-card">
                <a href="/blog/app-specialized-hiit-training" class="category-link">
                    <img src="/assets/blog/specialized-training-category.jpg" alt="Specialized Training" class="category-image">

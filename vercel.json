{
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        },
        {
            "source": "/.well-known/apple-app-site-association",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                }
            ]
        },
        {
            "source": "/.well-known/assetlinks.json",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/:path((?!\\.well-known).*)",
            "has": [
                {
                    "type": "host",
                    "value": "peakintervalapp.com"
                }
            ],
            "destination": "https://www.peakintervalapp.com/:path",
            "permanent": true
        },
        {
            "source": "/blog/posts/amrap-emom-hiit-formats-compared",
            "destination": "/blog/posts/amrap-emom-tabata-hiit-formats-compared",
            "permanent": true
        },
        {
            "source": "/blog/posts/emom-vs-amrap-vs-tabata-different-hiit-formats-compared",
            "destination": "/blog/posts/amrap-emom-tabata-hiit-formats-compared",
            "permanent": true
        },
        {
            "source": "/blog/posts/hydration-strategies-for-hiit",
            "destination": "/blog/posts/fasted-vs-fed-hiit",
            "permanent": true
        },
        {
            "source": "/blog/posts/combining-hiit-other-fitness",
            "destination": "/blog/posts/hiit-for-powerlifters",
            "permanent": true
        },
        {
            "source": "/blog/posts/syncing-music-hiit-intervals",
            "destination": "/blog/posts/interval-timer-with-music",
            "permanent": true
        },
        {
            "source": "/blog/posts/polarized-training-combining-hiit-with-very-low-intensity-work",
            "destination": "/blog/posts/hiit-vs-steady-state",
            "permanent": true
        },
        {
            "source": "/get",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*[Aa]ndroid.*"
                }
            ],
            "destination": "https://play.google.com/store/apps/details?id=com.roli.intervals",
            "permanent": false
        },
        {
            "source": "/get",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(iPhone|iPad|iPod).*"
                }
            ],
            "destination": "https://apps.apple.com/us/app/peak-interval-hiit-timer/id6741055716",
            "permanent": false
        },
        {
            "source": "/w/:path(.*)",
            "destination": "/download?workout=:path",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/.well-known/:path*",
            "destination": "/.well-known/:path*"
        },
        {
            "source": "/w/:path(.*)",
            "destination": "/download?workout=:path"
        }
    ]
}

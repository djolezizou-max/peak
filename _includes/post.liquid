<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- comment -%}
      Bing flags any title over 60 characters, and " | Peak Interval" spends 17
      of them before the title says anything. So the brand suffix is appended
      only when it fits, and a post can set `seoTitle` in front matter to give
      search a short title while the on-page h1 stays descriptive.
    {%- endcomment -%}
    {%- assign pageTitle = seoTitle | default: title -%}
    {%- assign branded = pageTitle | append: " | Peak Interval" -%}
    {%- if branded.size <= 60 -%}
    <title>{{ branded }}</title>
    {%- else -%}
    <title>{{ pageTitle }}</title>
    {%- endif -%}

    <!-- SEO Meta Tags -->
    <meta name="description" content="{{ description }}">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://www.peakintervalapp.com{{ page.url | stripTrailingSlash }}">

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:image" content="https://www.peakintervalapp.com{{ featured_image }}">
    <meta property="og:url" content="https://www.peakintervalapp.com{{ page.url | stripTrailingSlash }}">
    <meta property="og:type" content="article">

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="https://www.peakintervalapp.com{{ featured_image }}">

    <!-- Article JSON-LD for AI/search engines -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ title | jsonify }},
      "description": {{ description | jsonify }},
      "image": "https://www.peakintervalapp.com{{ featured_image }}",
      "datePublished": "{{ page.date | htmlDateString }}",
      "dateModified": "{{ page.date | htmlDateString }}",
      "author": {
        "@type": "Organization",
        "name": "Peak Interval",
        "url": "https://www.peakintervalapp.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Peak Interval",
        "url": "https://www.peakintervalapp.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.peakintervalapp.com/assets/app_icon.png"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://www.peakintervalapp.com{{ page.url | stripTrailingSlash }}"
      },
      "articleSection": {{ category | jsonify }},
      "inLanguage": "en"
    }
    </script>

    <!-- Breadcrumb JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.peakintervalapp.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://www.peakintervalapp.com/blog"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ category | jsonify }},
          "item": "https://www.peakintervalapp.com/blog/{{ category | slugify }}"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": {{ title | jsonify }},
          "item": "https://www.peakintervalapp.com{{ page.url | stripTrailingSlash }}"
        }
      ]
    }
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <!-- Styles from main site with blog-specific additions -->
    
    <script>
        // Function to get URL parameters
        function getQueryParam(param) {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get(param);
        }
        
        // Check if we're in app mode on page load
        document.addEventListener('DOMContentLoaded', function() {
            const isAppMode = getQueryParam('app') === 'true';
            
            if (isAppMode) {
                // Hide header, nav and footer when in app mode
                const header = document.querySelector('.header');
                const nav = document.querySelector('.nav');
                const footer = document.querySelector('.footer');
                const backLink = document.querySelector('.back-to-blog-link');
                
                if (header) header.style.display = 'none';
                if (nav) nav.style.display = 'none';
                if (footer) footer.style.display = 'none';
                
                // Hide all app download CTAs
                const ctaBoxes = document.querySelectorAll('.cta-box');
                const ctaButtons = document.querySelectorAll('.cta-button');
                
                ctaBoxes.forEach(box => {
                    // Check if the CTA mentions downloading the app
                    if (box.textContent.toLowerCase().includes('download') || 
                        box.textContent.toLowerCase().includes('app') ||
                        box.textContent.toLowerCase().includes('get peak interval')) {
                        box.style.display = 'none';
                    }
                });
                
                ctaButtons.forEach(button => {
                    if (button.textContent.toLowerCase().includes('download') || 
                        button.textContent.toLowerCase().includes('app') ||
                        button.textContent.toLowerCase().includes('get peak interval')) {
                        button.style.display = 'none';
                    }
                });
                
                // Get the post category for back link
                const category = "{{ category }}";
                const categorySlug = category.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]+/g, '');
                
                // Change back link to point to category page in app mode
                if (backLink) {
                    backLink.href = `/blog/app-${categorySlug}/?app=true`;
                    backLink.textContent = `← Back to ${category}`;
                }
                
                // Add more padding to the blog container for app view
                const blogContainer = document.querySelector('.blog-container');
                if (blogContainer) {
                    blogContainer.style.padding = '20px';
                    blogContainer.style.marginTop = '0';
                }
                
                // Create and add sticky back button with category link
                const stickyBackButton = document.createElement('div');
                stickyBackButton.className = 'sticky-back-button';
                stickyBackButton.innerHTML = `<a href="/blog/app-${categorySlug}/?app=true">← Back to ${category}</a>`;
                document.body.appendChild(stickyBackButton);
                
                // Get the original back button for position reference
                const originalBackButton = document.querySelector('.back-to-blog-link');
                
                // Scroll event handler
                function handleScroll() {
                    const scrollY = window.scrollY || window.pageYOffset;
                    
                    // Show sticky button when scrolled past a specific threshold
                    if (scrollY > 150) {
                        // Only show if original button is out of viewport
                        if (originalBackButton) {
                            const rect = originalBackButton.getBoundingClientRect();
                            if (rect.top < 0) {
                                stickyBackButton.classList.add('visible');
                            } else {
                                stickyBackButton.classList.remove('visible');
                            }
                        } else {
                            stickyBackButton.classList.add('visible');
                        }
                    } else {
                        stickyBackButton.classList.remove('visible');
                    }
                }
                
                // Initial check
                handleScroll();
                
                // Add scroll listener
                window.addEventListener('scroll', handleScroll, { passive: true });
                
                // Add resize listener to recalculate positions
                window.addEventListener('resize', handleScroll, { passive: true });
            }
        });
    </script>
    {% include "site-head.liquid" %}
</head>
<body>
{% include "site-header.liquid", active: "blog" %}

    <div class="blog-container">
        {% assign categorySlug = category | slugify %}
        <a href="/blog/{{ categorySlug }}" class="back-to-blog-link">‹ Back to {{ category }}</a>
        <article class="blog-post">
            <header class="blog-header">
                <h1 class="blog-title">{{ title }}</h1>
                {% if date %}
                <div class="blog-meta">Published on {{ date | date: "%B %d, %Y" }} {% if readingTime %}• {{ readingTime }} min read{% endif %}</div>
                {% endif %}
                {% if featured_image %}
                <img src="{{ featured_image }}" alt="{{ image_alt | default: title }}" class="featured-image">
                {% endif %}
            </header>

            <div class="blog-content">
                {{ content }}
            </div>
        </article>

        {%- comment -%}
          Related posts form a ring within each category: every post links to the
          6 that follow it, so link equity is spread evenly instead of pooling on
          whichever posts happen to sort first.

          A category with fewer than 7 posts cannot fill that ring on its own,
          and a category of one renders no links at all — which is how posts end
          up reachable only from /blog and a hub page. So the remainder is topped
          up from a site-wide ring, in the same rotating way. Every post then
          carries the same number of outbound links, and the link graph is not
          partitioned along category lines.

          Only 4 of the 6 slots go to the category, even when it could fill all
          six. A large category that fills its own ring is a closed loop: its
          posts link only to each other, so a cluster Google is ignoring has no
          way back in from the pages Google does crawl. The reserved 2 slots are
          what connect the clusters.
        {%- endcomment -%}
        {%- assign wanted = 6 -%}
        {%- assign categoryWanted = 4 -%}
        {%- assign categoryPosts = collections.posts | where: "data.category", category -%}
        {%- assign total = categoryPosts | size -%}
        {%- assign allPosts = collections.posts -%}
        {%- assign allTotal = allPosts | size -%}
        {%- assign shownUrls = "" -%}
        {%- assign shownCount = 0 -%}
        {%- if allTotal > 1 -%}
            {%- assign currentIndex = 0 -%}
            {%- for post in categoryPosts -%}
                {%- if post.url == page.url -%}{%- assign currentIndex = forloop.index0 -%}{%- endif -%}
            {%- endfor -%}
            {%- assign allIndex = 0 -%}
            {%- for post in allPosts -%}
                {%- if post.url == page.url -%}{%- assign allIndex = forloop.index0 -%}{%- endif -%}
            {%- endfor -%}
        <section class="related-posts">
            <h2>More from the blog</h2>
            <ul>
                {%- for post in categoryPosts -%}
                    {%- assign rel = forloop.index0 | minus: currentIndex -%}
                    {%- if rel < 0 -%}{%- assign rel = rel | plus: total -%}{%- endif -%}
                    {%- if rel > 0 and shownCount < categoryWanted -%}
                        {%- assign key = post.url | append: "|" -%}
                        {%- unless shownUrls contains key -%}
                            {%- assign shownUrls = shownUrls | append: key -%}
                            {%- assign shownCount = shownCount | plus: 1 -%}
                <li><a href="{{ post.url | stripTrailingSlash }}">{{ post.data.title }}</a></li>
                        {%- endunless -%}
                    {%- endif -%}
                {%- endfor -%}
                {%- comment -%}
                  The cross-category picks are taken a third and two thirds of
                  the way around the collection rather than from the next posts
                  along. Neighbours in this ordering were published together, so
                  a rotation hands a batch of new posts only to each other; a
                  stride hands them to the older posts Google already crawls.
                {%- endcomment -%}
                {%- assign stride = allTotal | divided_by: 3 -%}
                {%- assign stride2 = stride | times: 2 -%}
                {%- for post in allPosts -%}
                    {%- assign rel = forloop.index0 | minus: allIndex -%}
                    {%- if rel < 0 -%}{%- assign rel = rel | plus: allTotal -%}{%- endif -%}
                    {%- if shownCount < wanted -%}
                        {%- if rel == stride or rel == stride2 -%}
                            {%- assign key = post.url | append: "|" -%}
                            {%- unless shownUrls contains key -%}
                                {%- assign shownUrls = shownUrls | append: key -%}
                                {%- assign shownCount = shownCount | plus: 1 -%}
                <li><a href="{{ post.url | stripTrailingSlash }}">{{ post.data.title }}</a></li>
                            {%- endunless -%}
                        {%- endif -%}
                    {%- endif -%}
                {%- endfor -%}
                {%- comment -%} Anything still short is filled from the ring. {%- endcomment -%}
                {%- for post in allPosts -%}
                    {%- assign rel = forloop.index0 | minus: allIndex -%}
                    {%- if rel < 0 -%}{%- assign rel = rel | plus: allTotal -%}{%- endif -%}
                    {%- if rel > 0 and shownCount < wanted -%}
                        {%- assign key = post.url | append: "|" -%}
                        {%- unless shownUrls contains key -%}
                            {%- assign shownUrls = shownUrls | append: key -%}
                            {%- assign shownCount = shownCount | plus: 1 -%}
                <li><a href="{{ post.url | stripTrailingSlash }}">{{ post.data.title }}</a></li>
                        {%- endunless -%}
                    {%- endif -%}
                {%- endfor -%}
            </ul>
            <a href="/blog/{{ category | slugify }}" class="all-link">All {{ category }} articles →</a>
        </section>
        {%- endif -%}
    </div>

{% include "site-footer.liquid" %}
</body>
</html> 